{
  "event": "transfer.confirm",
  "messages": [
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "transfer",
        "components": [
          {
            "id": "root",
            "component": "Container",
            "maxW": "container.sm",
            "py": "8",
            "children": ["done"]
          },
          {
            "id": "done",
            "component": "Flex",
            "direction": "column",
            "align": "center",
            "gap": "4",
            "bg": "gray.700",
            "p": "8",
            "borderRadius": "xl",
            "textAlign": "center",
            "children": ["done-icon", "done-title", "done-text", "done-again"]
          },
          {
            "id": "done-icon",
            "component": "Icon",
            "name": "checkCircle",
            "color": "green.300",
            "boxSize": "12"
          },
          {
            "id": "done-title",
            "component": "Heading",
            "text": "Перевод выполнен",
            "as": "h1",
            "size": "lg"
          },
          {
            "id": "done-text",
            "component": "Text",
            "text": {
              "call": "formatString",
              "args": {
                "value": "${formatCurrency(value: ${/transfer/amount}, currency: 'RUB')} отправлены на номер ${/transfer/phone}"
              }
            },
            "color": "gray.300"
          },
          {
            "id": "done-again",
            "component": "Button",
            "label": "Новый перевод",
            "variant": "outline",
            "action": {
              "event": {
                "name": "transfer.new"
              }
            }
          }
        ]
      }
    }
  ]
}
