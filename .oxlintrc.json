{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    "node_modules",
    "*.tsbuildinfo",
    "test-results",
    "playwright-report",
    "scripts/lint-rules/fixtures"
  ],
  "plugins": ["eslint", "oxc", "react", "unicorn", "typescript", "import"],
  "jsPlugins": ["./scripts/oxlint-plugin/index.mjs"],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react-in-jsx-scope": "off",
    "eslint/no-shadow": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "import/no-namespace": "error",
    "agentic-ui/no-export-star": "error",
    "agentic-ui/effect-block-body": "error",
    "agentic-ui/no-random-uuid": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/ui-kit-one-react/src/**/*.{ts,tsx}"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@chakra-ui/*", "@emotion/*", "framer-motion"],
                "message": "Only src/kit/ may import the UI kit (kit boundary)."
              }
            ]
          }
        ],
        "agentic-ui/kit-boundary": ["error", { "allow": ["react", "@a2ui", "@agentic-ui", "zod"] }]
      }
    },
    {
      "files": ["packages/ui-kit-one-react/src/kit/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off",
        "agentic-ui/kit-boundary": "off"
      }
    }
  ]
}
