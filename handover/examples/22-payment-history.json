    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "payments",
        "components": [
          {
            "id": "root",
            "component": "Container",
            "maxW": "container.md",
            "py": "8",
            "children": ["stack"]
          },
          {
            "id": "stack",
            "component": "Flex",
            "direction": "column",
            "gap": "4",
            "children": ["header", "list"]
          },
          {
            "id": "header",
            "component": "Flex",
            "justify": "space-between",
            "align": "center",
            "children": ["title", "total"]
          },
          {
            "id": "title",
            "component": "Heading",
            "text": "Платежи за октябрь",
            "as": "h1",
            "size": "lg"
          },
          {
            "id": "total",
            "component": "Text",
            "text": {
              "call": "formatCurrency",
              "args": {
                "value": {
                  "path": "/total"
                },
                "currency": "RUB"
              }
            },
            "fontWeight": "semibold"
          },
          {
            "id": "list",
            "component": "List",
            "variant": "plain",
            "spacing": "2",
            "children": {
              "componentId": "payment",
              "path": "/payments"
            }
          },
          {
            "id": "payment",
            "component": "Flex",
            "align": "center",
            "gap": "4",
            "bg": "gray.700",
            "p": "4",
            "borderRadius": "xl",
            "borderWidth": "1px",
            "borderColor": "whiteAlpha.100",
            "children": ["payment-info", "payment-amount", "payment-status", "payment-repeat"]
          },
          {
            "id": "payment-info",
            "component": "Flex",
            "direction": "column",
            "w": "full",
            "children": ["payment-title", "payment-date"]
          },
          {
            "id": "payment-title",
            "component": "Text",
            "text": {
              "path": "title"
            },
            "fontWeight": "medium"
          },
          {
            "id": "payment-date",
            "component": "Text",
            "text": {
              "call": "formatDate",
              "args": {
                "value": {
                  "path": "date"
                },
                "format": "dd.MM.yyyy"
              }
            },
            "fontSize": "sm",
            "color": "gray.400"
          },
          {
            "id": "payment-amount",
            "component": "Text",
            "text": {
              "call": "formatCurrency",
              "args": {
                "value": {
                  "path": "amount"
                },
                "currency": "RUB"
              }
            },
            "fontWeight": "semibold"
          },
          {
            "id": "payment-status",
            "component": "Tag",
            "label": {
              "path": "status"
            },
            "variant": "outline"
          },
          {
            "id": "payment-repeat",
            "component": "Button",
            "label": "Повторить",
            "variant": "ghost",
            "size": "sm",
            "action": {
              "event": {
                "name": "payment.repeat",
                "context": {
                  "paymentId": {
                    "path": "id"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
