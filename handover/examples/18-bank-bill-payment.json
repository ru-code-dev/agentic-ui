            "id": "root",
            "component": "Container",
            "maxW": "container.sm",
            "py": "8",
            "children": ["card"]
          },
          {
            "id": "card",
            "component": "Flex",
            "direction": "column",
            "gap": "5",
            "bg": "gray.700",
            "p": "8",
            "borderRadius": "xl",
            "borderWidth": "1px",
            "borderColor": "whiteAlpha.100",
            "children": ["title", "tabs"]
          },
          {
            "id": "title",
            "component": "Heading",
            "text": "Оплата услуг",
            "as": "h1",
            "size": "md"
          },
          {
            "id": "tabs",
            "component": "Tabs",
            "variant": "soft-rounded",
            "selectedIndex": {
              "path": "/bills/tab"
            },
            "tabs": [
              {
                "title": "ЖКХ",
                "child": "housing"
              },
              {
                "title": "Мобильная связь",
                "child": "mobile"
              },
              {
                "title": "Интернет",
                "child": "internet"
              }
            ]
          },
          {
            "id": "housing",
            "component": "Flex",
            "direction": "column",
            "gap": "4",
            "children": ["housing-id", "housing-amount", "housing-pay"]
          },
          {
            "id": "housing-id",
            "component": "Input",
            "label": "Лицевой счёт",
            "value": {
              "path": "/bills/housing/account"
            },
            "type": "text",
            "placeholder": "Номер из квитанции",
            "isRequired": true,
            "checks": [
              {
                "condition": {
                  "call": "required",
                  "args": {
                    "value": {
                      "path": "/bills/housing/account"
                    }
                  }
                },
                "message": "Обязательное поле"
              }
            ]
          },
          {
            "id": "housing-amount",
            "component": "Input",
            "label": "Сумма, ₽",
            "value": {
              "path": "/bills/housing/amount"
            },
            "type": "number",
            "isRequired": true,
            "checks": [
              {
                "condition": {
                  "call": "numeric",
                  "args": {
                    "value": {
                      "path": "/bills/housing/amount"
                    },
                    "min": 1
                  }
                },
                "message": "Укажите сумму"
              }
            ]
          },
          {
            "id": "housing-pay",
            "component": "Button",
            "label": "Оплатить",
            "colorScheme": "blue",
            "action": {
              "event": {
                "name": "bill.pay",
                "context": {
                  "service": "housing",
                  "amount": {
                    "path": "/bills/housing/amount"
                  }
                }
              }
            },
            "checks": [
              {
                "condition": {
                  "call": "required",
                  "args": {
                    "value": {
                      "path": "/bills/housing/account"
                    }
                  }
                },
                "message": "Реквизиты"
