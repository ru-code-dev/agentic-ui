{
  "name": "Оплата услуг",
  "description": "Оплата ЖКХ, связи и интернета во вкладках.",
  "messages": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "bills",
        "catalogId": "urn:agentic-ui:catalog:ui-kit-one:v1",
        "sendDataModel": true
      }
    },
    {
      "version": "v0.9",
      "updateDataModel": {
        "surfaceId": "bills",
        "path": "/bills",
        "value": {
          "tab": 0,
          "housing": {
            "account": "",
            "amount": ""
          },
          "mobile": {
            "phone": "",
            "amount": ""
          },
          "internet": {
            "contract": "",
            "amount": ""
          }
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
